---
import { Picture as AstroImage } from "astro:assets";
const { src, alt, width, height, caption } = Astro.props;
---

<div style={{ textAlign: "center" }}>
  <figure>
    <AstroImage
      src={src || ""}
      formats={["avif", "webp"]}
      width={width || 700}
      height={height || 700}
      alt={alt || ""}
    />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</div>
